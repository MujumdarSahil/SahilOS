# SAHIL.OS 2.0 Environment Configuration

# Optional: Gemini API key for server-side JARVIS AI responses
# When omitted, JARVIS gracefully uses verified local deterministic knowledge fallback
GEMINI_API_KEY=

# Optional: Preferred model identifier (defaults to free tier gemini-1.5-flash or gemini-2.0-flash)
AI_MODEL=gemini-1.5-flash

# Application Mode
NODE_ENV=development
